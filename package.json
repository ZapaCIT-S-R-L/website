{
  "name": "zapakid-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 build.py",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "lint": "prettier --check . && eslint . && uvx ruff@0.17.2 check build.py && uvx ruff@0.17.2 format --check build.py",
    "format": "prettier --write . && uvx ruff@0.17.2 format build.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "wrangler": "^4.151.2"
  },
  "license": "AGPL-3.0-only"
}
