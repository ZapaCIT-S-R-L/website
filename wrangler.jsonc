{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zapakid-site",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",

  // The static pages are the repo root (generated by build.py); .assetsignore keeps the rest out.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },

  // The Worker owns these hostnames and their DNS records (not Terraform, see the infra repo). No workers.dev URL.
  "routes": [
    { "pattern": "www.zapakid.ro", "custom_domain": true },
    { "pattern": "zapakid.ro", "custom_domain": true },
  ],
  "workers_dev": false,

  "observability": { "enabled": true },
}
